{% assign repo_url = include.repository | split: '/' %}
{% if site.data.repositories.github_users contains repo_url.first %}
  {% assign show_owner = false %}
{% else %}
  {% assign show_owner = true %}
{% endif %}

<div class="repo p-2">
  <a class="repo-card" href="https://github.com/{{ include.repository }}">
    <span class="repo-card-icon" aria-hidden="true"><i class="fab fa-github"></i></span>
    <span>
      <strong>{{ repo_url.last | replace: '-', ' ' | replace: '_', ' ' }}</strong>
      <small>{% if show_owner %}{{ repo_url.first }} / {% endif %}{{ repo_url.last }}</small>
    </span>
  </a>
</div>
